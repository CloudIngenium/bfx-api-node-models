{
  "name": "@cloudingenium/bfx-api-node-models",
  "version": "11.0.0",
  "description": "TypeScript models for the Bitfinex API — CloudIngenium modernized fork",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "postbuild": "node scripts/check-dist.mjs",
    "lint": "oxlint --max-warnings 0",
    "lint:fix": "oxlint --fix",
    "test": "npm run build && node --test --experimental-test-coverage --test-coverage-lines=94 --test-coverage-branches=87 --test-coverage-functions=94 'test/**/*.test.ts'",
    "package-source:generate": "node scripts/generate-package-source.mjs",
    "package-source:check": "node scripts/generate-package-source.mjs --check",
    "prepublishOnly": "npm run build && npm run package-source:check"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CloudIngenium/bfx-api-node-models.git"
  },
  "keywords": [
    "bitfinex",
    "bitcoin",
    "BTC",
    "typescript",
    "models"
  ],
  "author": "Bitfinex",
  "contributors": [
    "JC <jcbauza@users.noreply.github.com> (https://github.com/jcbauza)",
    "Jacob Plaster <jacob.plaster@bitfinex.com> (https://www.bitfinex.com)",
    "Ezequiel Wernicke <ezequiel.wernicke@bitfinex.com> (https://www.bitfinex.com)",
    "Cris Mihalache <cris.m@bitfinex.com> (https://www.bitfinex.com)",
    "Paolo Ardoino <paolo@bitfinex.com> (https://www.bitfinex.com)",
    "Vigan Abdurrahmani <vigan.abdurrahmani@bitfinex.com> (https://www.bitfinex.com)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CloudIngenium/bfx-api-node-models/issues"
  },
  "homepage": "https://github.com/CloudIngenium/bfx-api-node-models#readme",
  "dependencies": {
    "bignumber.js": "^11.1.5",
    "crc-32": "^1.2.2"
  },
  "devDependencies": {
    "@cloudingenium/oxlint-config": "^1.1.0",
    "@types/node": "^26.1.1",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "~7.0.2"
  },
  "publishConfig": {
    "@cloudingenium:registry": "https://npm.pkg.github.com"
  },
  "packageManager": "pnpm@12.15.0"
}
